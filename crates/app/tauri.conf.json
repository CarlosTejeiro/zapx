{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "ZAPX",
  "version": "0.9.0",
  "identifier": "app.zapx.client",
  "build": {
    "beforeDevCommand": { "cwd": "../../frontend", "script": "npm run dev" },
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": { "cwd": "../../frontend", "script": "npm run build" },
    "frontendDist": "../../frontend/dist"
  },
  "app": {
    "windows": [
      {
        "title": "ZAPX",
        "decorations": false,
        "transparent": true,
        "dragDropEnabled": false,
        "width": 1200,
        "height": 800,
        "minWidth": 900,
        "minHeight": 600
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "category": "DeveloperTool",
    "shortDescription": "Cross-platform multi-protocol terminal — SSH/Telnet/Serial with SFTP, tunnels, snippets and login automation.",
    "longDescription": "ZAPX is a modern terminal client for network engineers and developers. SSH (password / public key / agent / 2FA) with ProxyJump and port forwarding, Telnet (RFC 854), Serial, SFTP browser, multi-exec broadcast, persistent snippets, automated login scripts, and a recursive split-pane workspace.",
    "copyright": "© 2026 ZAPX contributors",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "createUpdaterArtifacts": false
  },
  "plugins": {
    "updater": {
      "active": false,
      "endpoints": [
        "https://example.com/zapx/updates/{{target}}/{{arch}}/{{current_version}}"
      ],
      "dialog": false,
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IDJFQzJGNTU2QUMwNEQ1QkEKUldTNjFRU3NWdlhDTGk1eDBUL3dWYTB5WVl5ZS9HWStxWUF0bVZJRjQwcGVHelRmWW5nY0sxeWwK"
    }
  }
}
