{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "zapx",
  "version": "0.1.0",
  "identifier": "dev.zapx.app",
  "build": {
    "beforeDevCommand": "",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "cd ../../frontend && pnpm build",
    "frontendDist": "../../frontend/dist"
  },
  "app": {
    "windows": [
      {
        "title": "zapx",
        "decorations": false,
        "width": 1200,
        "height": 800,
        "minWidth": 900,
        "minHeight": 600
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": false,
    "targets": "all",
    "icon": []
  }
}
